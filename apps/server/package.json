{
  "name": "@pokerall/server",
  "version": "0.1.0",
  "private": true,
  "description": "PokerALL server: accounts, profile and progress sync, account deletion. Later: friends, chat, ranked play.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "migrate": "tsx src/db/migrate-cli.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "@pokerall/moderation": "workspace:*",
    "@pokerall/shared": "workspace:*",
    "argon2": ">=0.41.0 <1",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.4.0",
    "jose": "^6.0.0",
    "pg": "^8.16.0",
    "tsx": "^4.20.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "~6.0.3",
    "vitest": "^4.0.0"
  }
}
