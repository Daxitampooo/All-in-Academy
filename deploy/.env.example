# Copy to deploy/.env on the server and fill in. Never commit the filled file.

# Domain (or subdomain) pointed at the server's IP address, for example api.pokerall.app
DOMAIN=

# Database password: a long random string, e.g. the output of `openssl rand -hex 24`
POSTGRES_PASSWORD=

# Signs sign-in tokens: a long random string, e.g. the output of `openssl rand -hex 32`
JWT_SECRET=

# OAuth client ids from Google Cloud, comma separated (Android and web). Empty: Google sign-in is off.
GOOGLE_CLIENT_IDS=
